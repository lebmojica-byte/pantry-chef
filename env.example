# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…, public by design)
NEXT_PUBLIC_SUPABASE_URL=https://ymogmyxmlomjvsqspzzu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pRXcBC3WpoTGRTgUS23KkA_PET3iQgc

# AI providers, server-side only. Groq is tried first, Mistral is the fallback. At least one is required.
GROQ_API_KEY=
MISTRAL_API_KEY=
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# MISTRAL_MODEL=mistral-small-latest

# Recipe requests per user per day
AI_DAILY_LIMIT_PER_USER=30

# Cloudflare Turnstile site key (leave empty to switch the widget off).
# The secret key goes into Supabase → Authentication → Attack Protection, not here.
TURNSTILE_SITE_KEY=
